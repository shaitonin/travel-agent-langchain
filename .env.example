# ============================================================
# Assistente de Viagens - LangChain Agents
# Preencha as chaves abaixo. Copie para .env e preencha (ou deixe USE_DUMMY=true).
# ============================================================

# --- OpenAI (obrigatória) ---
# Crie em: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# --- LangSmith (obrigatória para tracing e avaliação) ---
# Crie em: https://smith.langchain.com  ->  Settings -> API Keys
LANGSMITH_API_KEY=lsv2_...
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=assistente-viagens
LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com

# --- Modo dummy ---
# true  = roda sem chaves (LLM simulado e APIs externas mockadas), para avaliação offline
# false = usa as chaves reais acima
USE_DUMMY=true

# --- APIs externas (não precisam de chave) ---
# Open-Meteo (clima):    https://open-meteo.com
# Frankfurter (câmbio):  https://www.frankfurter.app
